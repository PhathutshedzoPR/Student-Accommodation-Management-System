# Copy this file to .env and fill in real values before running the server.

# PostgreSQL connection string.
# Local example:   postgresql://postgres:postgres@localhost:5432/accommodation
# Supabase/Railway: use the connection string they give you.
DATABASE_URL=postgresql://user:pass@localhost:5432/accommodation

# Secrets used to sign JWTs. Use long random strings in production.
JWT_SECRET=change-this-in-production
JWT_REFRESH_SECRET=another-secret-change-this-too

# Access token lifetime (short) and refresh token lifetime (long).
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

PORT=3001

# Passphrase used to derive the AES-256 key that encrypts visitor ID/passport
# numbers at rest. Any string works (a key is derived from it via scrypt) —
# just change it in production and never commit the real value.
ENCRYPTION_KEY=change-this-passphrase-in-production

# Comma-separated list of origins allowed to call this API.
CORS_ORIGIN=http://localhost:5173

# Where uploaded files (application documents, complaint photos) are written.
# This scaffold stores them on local disk under this folder and serves them
# statically at /uploads. Swap for S3/Cloudinary in production (see
# src/utils/upload.ts).
UPLOAD_DIR=uploads
